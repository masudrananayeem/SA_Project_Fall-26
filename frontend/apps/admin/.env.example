# Leave VITE_API_URL empty locally: Vite (npm run dev:*) and nginx (Docker) proxy /api to the backend.
# On Vercel set it to the backend origin, e.g. https://meterflow-api.<you>.workers.dev
VITE_API_URL=
# Links between the two apps (login page "go to the other app" link).
VITE_ADMIN_URL=http://localhost:5173
VITE_CLIENT_URL=http://localhost:5174
