{
  "name": "meterflow-frontend",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev:admin": "npm run dev -w @meterflow/admin",
    "dev:client": "npm run dev -w @meterflow/client",
    "build": "npm run build -w @meterflow/admin && npm run build -w @meterflow/client",
    "build:admin": "npm run build -w @meterflow/admin",
    "build:client": "npm run build -w @meterflow/client",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
