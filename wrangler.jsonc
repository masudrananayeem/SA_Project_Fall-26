{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meterflow-api",
  "main": "cloudflare/index.ts",
  "compatibility_date": "2026-11-16",
  // Daily at 00:15 UTC (06:15 Dhaka): trials, renewals, dunning retries, account standing,
  // and on the 1st the month-end billing run. See runDailyJobs in cloudflare/index.ts.
  "triggers": { "crons": ["15 0 * * *"] },
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "MeterFlowApiContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "base": { "dockerfile": "./backend/Dockerfile" }
      }
    }
  ],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MeterFlowApiContainer"] }],
  "durable_objects": {
    "bindings": [
      { "name": "METERFLOW_API", "class_name": "MeterFlowApiContainer" }
    ]
  },
  "exports": {
    "MeterFlowApiContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
