{
  "name": "meterflow-cloudflare-deployer",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "cf:types": "wrangler types",
    "local:up": "powershell -ExecutionPolicy Bypass -File scripts/run-local.ps1",
    "local:down": "powershell -ExecutionPolicy Bypass -File scripts/stop-local.ps1",
    "local:check": "powershell -ExecutionPolicy Bypass -File scripts/check-local-prerequisites.ps1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "typescript": "latest",
    "wrangler": "latest"
  }
}
